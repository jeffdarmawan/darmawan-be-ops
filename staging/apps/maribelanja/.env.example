# Maribelanja staging env — Docker Compose reads this file automatically.
# `make secrets` (darmawan.be/staging) writes a filled .env on the server;
# this file documents what goes into it.

# Generate with: mix phx.gen.secret   (or: openssl rand -base64 48)
SECRET_KEY_BASE=

# Random hex (URL-safe — it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Must match the hostname users browse — Phoenix's check_origin rejects the
# LiveView WebSocket from any other host.
PHX_HOST=maribelanja.darmawan.be
POOL_SIZE=10

# Staging mail: the bundled Mailpit relay. Read it at http://localhost:8025
# through an SSH tunnel: ssh -L 8025:127.0.0.1:8025 ubuntu@<staging-host>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=staging@maribelanja.local

# Google sign-in (Assent). Optional: empty/absent = the auth screens hide the
# Google buttons. Client id/secret come from Google Cloud Console; the values
# are added on the SERVER's .env by hand — rsync never syncs .env (see the
# "`.env` never syncs" note in staging/README.md). The redirect URI is not
# needed here: docker-compose.staging.yml hardcodes the staging callback URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Receipt photo scanning (opencode Go). Empty = the upload card reports that
# scanning is not configured; everything else keeps the app defaults.
# Values are added on the SERVER's .env by hand, like the Google pair.
OPENCODE_API_KEY=
RECEIPT_SCAN_PROVIDER=vision_llm
RECEIPT_SCAN_BASE_URL=https://opencode.ai/inference/go/openai/v1
RECEIPT_SCAN_MODEL=deepseek-v4.1-flash
RECEIPT_SCAN_TIMEOUT_MS=120000
RECEIPT_SCAN_STREAM=true
RECEIPT_SCAN_STRUCTURED_OUTPUT=json_schema
RECEIPT_SCAN_REASONING_EFFORT=low

# Receipt photo storage (S3). Leaving BUCKET empty keeps photos on the
# container's disk under tmp/, which the next `make maribelanja` wipes on
# rebuild. Fine for a quick look, wrong if photos should survive a deploy.
# With BUCKET set, saving a receipt that has a photo does one S3 PUT, and a
# failed upload blocks the save.
#
# The bucket has to exist before the app boots. The app resolves credentials
# in this order: AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, then pod identity,
# then the EC2 instance role. This staging box is a plain EC2 instance with
# no role, so the keys below are what it uses. Give it a dedicated IAM user
# scoped to this one bucket; setup steps are in staging/README.md.
#
# REGION is required whenever BUCKET is set: runtime.exs raises at boot when
# it is missing and no AWS_REGION is set.
RECEIPT_IMAGE_BUCKET=
RECEIPT_IMAGE_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Admin app (admin.maribelanja.darmawan.be). Runs as a second container from
# the same image on its own port, sharing the customer database.
# Admin accounts are never self-registered, so the first one is created on
# the server after deploy:
#   docker compose -f docker-compose.staging.yml exec admin \
#     /app-admin/bin/maribelanja_admin eval \
#     'Maribelanja.Release.create_admin("you@example.com", "a strong password")'
# The password must be 12 characters or more.
#
# ADMIN_HOST / ADMIN_SCHEME / ADMIN_URL_PORT are only used to build the links
# in admin password-reset emails. They must match the URL admins browse, not
# the internal port, so with Caddy on 443 this is the public hostname with
# scheme https and port 443.
ADMIN_PORT=4001
ADMIN_HOST=admin.maribelanja.darmawan.be
ADMIN_SCHEME=https
ADMIN_URL_PORT=443
