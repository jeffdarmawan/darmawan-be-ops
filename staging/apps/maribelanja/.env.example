# Maribelanja staging env — Docker Compose reads this file automatically.
# `make secrets` (darmawan.be/staging) writes a filled .env on the server;
# this file documents what goes into it.

# Generate with: mix phx.gen.secret   (or: openssl rand -base64 48)
SECRET_KEY_BASE=

# Random hex (URL-safe — it goes into DATABASE_URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Must match the hostname users browse — Phoenix's check_origin rejects the
# LiveView WebSocket from any other host.
PHX_HOST=maribelanja.darmawan.be
POOL_SIZE=10

# Staging mail: the bundled Mailpit relay. Read it at http://localhost:8025
# through an SSH tunnel: ssh -L 8025:127.0.0.1:8025 ubuntu@<staging-host>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=staging@maribelanja.local
