# NaikBusAja staging env — Docker Compose reads this file automatically.
# `make secrets` (darmawan.be/staging) writes a filled .env on the server;
# this file documents what goes into it.

# Generate with: mix phx.gen.secret   (must be >= 64 bytes)
SECRET_KEY_BASE=

# Must match the hostname users browse — Phoenix's check_origin rejects the
# LiveView WebSocket from any other host.
PHX_HOST=naikbusaja.darmawan.be

# Caddy terminates TLS; the app must build https:// URLs.
PHX_SCHEME=https

# Staging mail: the bundled Mailpit relay. Defaults live in
# docker-compose.staging.yml (SMTP_HOST=mailpit, SMTP_PORT=1025), so these
# lines are only needed to override. Read it at http://localhost:8026 through
# an SSH tunnel: ssh -L 8026:127.0.0.1:8026 ubuntu@<staging-host>
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SSL=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Empty MAIL_FROM falls back to the app default:
#   "NaikBusAja" <no-reply@naikbusaja.local>
# MAIL_FROM=

# Google sign-in. Both are needed together; if either is blank the app keeps
# its compile-time placeholder client and Google answers "invalid_client" on
# the authorize request. The client must also have this exact redirect URI
# registered in Google Cloud Console:
#   https://naikbusaja.darmawan.be/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
