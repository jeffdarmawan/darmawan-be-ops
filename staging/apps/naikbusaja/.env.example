# NaikBusAja staging env — Docker Compose reads this file automatically.
# `make secrets` (darmawan.be/staging) writes a filled .env on the server;
# this file documents what goes into it.

# Generate with: mix phx.gen.secret   (must be >= 64 bytes)
SECRET_KEY_BASE=

# Must match the hostname users browse — Phoenix's check_origin rejects the
# LiveView WebSocket from any other host.
PHX_HOST=naikbusaja.darmawan.be

# Caddy terminates TLS; the app must build https:// URLs.
PHX_SCHEME=https
